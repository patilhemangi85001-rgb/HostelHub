@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <span class="hero-badge">🏠 SMART HOSTEL MANAGEMENT</span>

            <h1>
                Welcome to <span>HostelHub</span>
            </h1>

            <p>
                A smarter way to manage hostel complaints, rooms,
                notices and student services — all in one place.
            </p>

            <div class="hero-buttons">
                <a href="#" class="btn-primary">Get Started →</a>
                <a href="#services" class="btn-secondary">Explore Services</a>
            </div>
        </div>

        <div class="hero-card">
            <div class="card-icon">🏠</div>
            <h3>HostelHub</h3>
            <p>Everything your hostel needs, in one place.</p>

            <div class="mini-stats">
                <div>
                    <strong>24/7</strong>
                    <span>Access</span>
                </div>

                <div>
                    <strong>100%</strong>
                    <span>Digital</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="services" id="services">
    <div class="section-heading">
        <span>OUR SERVICES</span>
        <h2>Everything in one place</h2>
        <p>
            HostelHub makes everyday hostel management simple,
            organized and transparent.
        </p>
    </div>

    <div class="service-grid">

        <div class="service-card">
            <div class="service-icon">🛠️</div>
            <h3>Complaints</h3>
            <p>
                Report hostel maintenance problems and track
                their status easily.
            </p>
        </div>

        <div class="service-card">
            <div class="service-icon">📢</div>
            <h3>Hostel Notices</h3>
            <p>
                Stay updated with important announcements
                and hostel information.
            </p>
        </div>

        <div class="service-card">
            <div class="service-icon">🏠</div>
            <h3>Room Management</h3>
            <p>
                View room information and keep hostel
                accommodation organized.
            </p>
        </div>

        <div class="service-card">
            <div class="service-icon">🍱</div>
            <h3>Mess Feedback</h3>
            <p>
                Share your feedback about food quality,
                taste and cleanliness.
            </p>
        </div>

    </div>
</section>

<section class="why-hostelhub">
    <div>
        <span>WHY HOSTELHUB?</span>
        <h2>Making hostel life a little easier.</h2>
        <p>
            From reporting a broken fan to checking the latest
            hostel notice, HostelHub brings everything together
            in a simple digital platform.
        </p>
    </div>

    <div class="feature-list">
        <div>✓ Easy complaint tracking</div>
        <div>✓ Quick hostel announcements</div>
        <div>✓ Simple student dashboard</div>
        <div>✓ Organized administration</div>
    </div>
</section>